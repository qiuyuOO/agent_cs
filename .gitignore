# --- 密钥与本地配置 (绝不入库) ---
.env
.env.*
!.env.example

# --- 运行时产物 / 中间文件 ---
# data/ 是本地用户状态 (偏好 / 运行记录的 sqlite), 不该进版本库;
# 用 .gitkeep 保留空目录本身。
data/
!data/.gitkeep
out/
work/
assets/
*.mp4
*.mkv
*.wav
*.mp3
!_keep/

# clipstore 是运行期生成的片段缓存目录 (名字带随机后缀, 权限还经常锁住),
# 既不该入库也不该让 git 每次扫描时报 "Permission denied"
clipstore_*/

# --- 依赖与工具 (体积大, 可由 requirements.txt 重建) ---
.venv/
# tools/ 整体忽略 (tools/ffmpeg 是 295 MB 的二进制), 但 tools/dev 例外 ——
# 那里是几十 KB 的取证/自检脚本, 自检要用到它们; 整个目录都忽略的话,
# 干净 clone 之后 "前端可无头执行" 那个用例会直接失效。
# 注意: 要让否定规则生效, 必须先把父目录 tools/ 自己重新纳入 (!tools/),
# 否则 git 根本不会进这个目录看里面的规则。
tools/*
!tools/dev/
!tools/.gitkeep
.cache/
.home/
.deps/
.pipcache/
.tmp/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# --- IDE / 系统 ---
.idea/
.vscode/
*.swp
Thumbs.db
desktop.ini

# --- Agent 工具在工作区里自动生成的脚手架 (由工具自己管理, 不属于本项目) ---
.agents/
skills-lock.json
